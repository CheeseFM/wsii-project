
# Windows Server II - Vagrant template
#  2026-2027
# ------------------------------------
#                                      
# This is the Vagrantfile for the assignment of Windows Server II - 2026-2027.
# The placeholder IPs below only tell VirtualBox which host-only network to use
# (192.168.26.0/24, host = 192.168.26.1). The real IPs are set by PowerShell (see config.psd1).
# The setup consists of 3 Windows Server machines (no GUI) and 1 Windows 11 client.
#
# Use `vagrant up` to bring up the environment, 
#   or `vagrant reload` to redeploy the environment after changing this file.
#
# You are allowed to modify this file as needed.
# However, you are not allowed to use any other vagrant boxes than the ones used in this file:
# - Windows Server 2025 core (no GUI): gusztavvargadr/windows-server-2025-standard-core
# - Windows 11 Enterprise 25H2: gusztavvargadr/windows-11-25h2-enterprise
# For both versions, the version is pinned - do not change this.
# You can change the amount of vRAM and vCPU assigned to each VM if needed.
# Each VM has 2 network interfaces:
# - first adapter in (default) NAT mode, for internet access + vagrant
# - second adapter connected to a (private) Host-Only network (no IP configuration done, this needs to be done by PowerShell!)
# Use PowerShell scripts to configure the second NIC interfaces, 
#   and to install and configure the required software.
# You are allowed to add lines for automatic provisioning.

Vagrant.configure("2") do |config|
  # Server 1
  config.vm.define "server1" do |server1|
    # This is the base image for the VM - do not change this!
    server1.vm.box = "gusztavvargadr/windows-server-2025-standard-core"
    server1.vm.box_version = "2607.0.0"
    # Connect the second adapter to an internal network, do not configure IP (the provided IP is just a place holder)
    server1.vm.network "private_network", ip: "192.168.26.10", auto_config: false
    # Hostname is set by common\base.ps1 (from config.psd1), not by Vagrant
    # Basic configuration: hostname, network, DNS client
    server1.vm.provision "base", type: "shell", inline: "C:\\vagrant\\common\\base.ps1 -Node server1", reboot: true
    # Active Directory: new forest + DNS. The script only schedules the
    # promotion; server1 promotes and reboots itself after Vagrant is done
    # (no reboot: true, see 01-adds.ps1).
    server1.vm.provision "adds", type: "shell", inline: "C:\\vagrant\\server1\\01-adds.ps1"
    # Steps after the promotion use run: "never": Vagrant may not contact
    # server1 until it has rebooted. Run them with a second command
    # (adds again: removes the task and shows the promotion log):
    #   vagrant provision server1 --provision-with adds,dns,users,iis
    # DNS: NAT IP out of DNS, reverse zone, A/PTR per server, NS + zone transfers
    server1.vm.provision "dns", type: "shell", run: "never", inline: "C:\\vagrant\\server1\\02-dns.ps1"
    # OUs and users from ous.psd1
    server1.vm.provision "users", type: "shell", run: "never", inline: "C:\\vagrant\\server1\\03-ous-users.ps1"
    # IIS: Hello World site on http://intranet.<domain>
    server1.vm.provision "iis", type: "shell", run: "never", inline: "C:\\vagrant\\server1\\04-iis.ps1"
    # VirtualBox specific configuration
    server1.vm.provider "virtualbox" do |vb|
      # VirtualBox Display Name
      vb.name = "server1"
      # VirtualBox Group
      vb.customize ["modifyvm", :id, "--groups", "/WS2"]
      # 2GB vRAM
      vb.memory = "6144"
      # 2vCPU
      vb.cpus = "2"
    end
  end

  # Server 2
  config.vm.define "server2" do |server2|
    server2.vm.box = "gusztavvargadr/windows-server-2025-standard-core"
    server2.vm.box_version = "2607.0.0"
    server2.vm.network "private_network", ip: "192.168.26.20", auto_config: false
    server2.vm.provision "base", type: "shell", inline: "C:\\vagrant\\common\\base.ps1 -Node server2", reboot: true
    # Domain member (no DC!) - needs server1 to be done
    server2.vm.provision "join", type: "shell", inline: "C:\\vagrant\\common\\join-domain.ps1 -Node server2", reboot: true
    # Secondary zones for the forward + reverse zone, master = server1
    server2.vm.provision "dns", type: "shell", inline: "C:\\vagrant\\server2\\01-dns-secondary.ps1"
    server2.vm.provider "virtualbox" do |vb|
      vb.name = "server2"
      vb.customize ["modifyvm", :id, "--groups", "/WS2"]
      vb.memory = "6144"
      vb.cpus = "2"
    end
  end

  # Server 3
  config.vm.define "server3" do |server3|
    server3.vm.box = "gusztavvargadr/windows-server-2025-standard-core"
    server3.vm.box_version = "2607.0.0"
    server3.vm.network "private_network", ip: "192.168.26.30", auto_config: false
    server3.vm.provision "base", type: "shell", inline: "C:\\vagrant\\common\\base.ps1 -Node server3", reboot: true
    server3.vm.provider "virtualbox" do |vb|
      vb.name = "server3"
      vb.customize ["modifyvm", :id, "--groups", "/WS2"]
      vb.memory = "8192"
      vb.cpus = "2"
    end
  end

  # Client
  config.vm.define "client" do |client|
    client.vm.box = "gusztavvargadr/windows-11-25h2-enterprise"
    client.vm.box_version = "2607.1.0"
    client.vm.network "private_network", ip: "192.168.26.40", auto_config: false
    client.vm.provision "base", type: "shell", inline: "C:\\vagrant\\common\\base.ps1 -Node client", reboot: true
    client.vm.provider "virtualbox" do |vb|
      vb.name = "client"
      vb.customize ["modifyvm", :id, "--groups", "/WS2"]
      vb.memory = "2048"
      vb.cpus = "2"
    end
  end

  # Is Hyper-V volledig uitgeschakeld, maar krijg je nog steeds timeouts bij uitrollen van de client?
  # Dan kan je eventueel de timeout aanpassen in onderstaande regel. De standaard timeout is 300 seconden (5 minuten), maar is nu al aangepast naar 600 seconden (10 minuten).
  config.vm.boot_timeout = 600
end
  